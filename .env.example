# Pasar x402 configuration. "npm run setup" writes a ready .env for BSC testnet with fresh wallets.
# Without a .env the project runs on the local Hardhat chain with public dev keys.

# local | bsc-testnet
NETWORK=bsc-testnet

# Facilitator wallet: pays gas for settlements and deploys/mints pUSD. Needs test BNB.
FACILITATOR_PRIVATE_KEY=
# Shared secret between the stalls/gateway and the facilitator.
FACILITATOR_API_KEY=

# Seller wallet that every stall pays.
PAY_TO_ADDRESS=

# Shopping agent wallet (signs payments, needs no BNB) and its limits.
AGENT_PRIVATE_KEY=
AGENT_DAILY_BUDGET_USD=1
AGENT_MAX_PER_PAYMENT_USD=0.1
AGENT_ALLOWED_HOSTS=127.0.0.1,localhost

# Prices (dollar strings are priced in pUSD).
# PRICE_TOKEN_CHECK=$0.01
# PRICE_AI_GENERATE=$0.02
# PRICE_MCP_TOKEN_CHECK=$0.01
# PRICE_MCP_AI=$0.02

# Ports and URLs (defaults shown).
# FACILITATOR_PORT=4020
# SERVER_PORT=4021
# GATEWAY_PORT=4022
# FACILITATOR_URL=http://127.0.0.1:4020
# SERVER_URL=http://127.0.0.1:4021
# GATEWAY_URL=http://127.0.0.1:4022

# RPC endpoints (comma-separated, tried in order).
# PAYMENT_RPC_URLS=https://bsc-testnet-rpc.publicnode.com
# BSC_MAINNET_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc-dataseed.bnbchain.org

# Use an already deployed pUSD instead of deployments/<network>.json.
# PAYMENT_TOKEN_ADDRESS=

# Local AI stall (https://ollama.com).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# Telegram shopping agent (@BotFather). Limit it to your own user id(s).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
